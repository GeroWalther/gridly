{
  "name": "gridly",
  "version": "1.0.0",
  "description": "A spreadsheet app for macOS that reads and writes real Excel files",
  "main": "src/main/main.js",
  "author": "Gero Walther",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "bundle": "esbuild src/renderer/app.js --bundle --outfile=src/renderer/bundle.js --format=iife --platform=browser --target=chrome120",
    "start": "npm run bundle && electron .",
    "pack": "npm run bundle && electron-builder --mac --arm64"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hyperformula": "^3.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "uuid": "^14.0.1"
  },
  "build": {
    "appId": "com.gerowalther.gridly",
    "productName": "Gridly",
    "copyright": "Copyright (c) 2026 Gero Walther",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "src/shared/**/*",
      "src/renderer/index.html",
      "src/renderer/styles.css",
      "src/renderer/bundle.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ],
      "icon": "build/icon.icns",
      "identity": "Gero Walther (W67AW8RFW4)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "fileAssociations": [
        {
          "ext": ["xlsx", "xlsm"],
          "name": "Excel Workbook",
          "role": "Editor",
          "rank": "Alternate"
        },
        {
          "ext": ["xls"],
          "name": "Excel 97-2003 Workbook",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": ["csv"],
          "name": "Comma Separated Values",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    }
  }
}
